HI_HAT_API_TOKEN=replace-with-a-long-random-token
HI_HAT_BIND_HOST=127.0.0.1
HI_HAT_BIND_PORT=8765
HI_HAT_DATA_DIR=data
HI_HAT_STAGING_DIR=tmp
HI_HAT_MONOCHROME_API_INSTANCES=["https://monochrome-api.samidy.com","https://api.monochrome.tf"]
# Optional: only configure a resolver and token you are authorized to use.
HI_HAT_MONOCHROME_UNIFIED_API_BASE_URL=
HI_HAT_MONOCHROME_UNIFIED_API_TOKEN=
# Local WebView2 helper. It keeps provider authentication inside its own browser profile.
HI_HAT_MONOCHROME_BROWSER_HELPER_URL=http://127.0.0.1:8876
HI_HAT_MONOCHROME_BROWSER_TIMEOUT_SECONDS=1800
# JSON list of folders containing FLAC files owned or controlled by the user.
HI_HAT_PERSONAL_LIBRARY_ROOTS=[]
